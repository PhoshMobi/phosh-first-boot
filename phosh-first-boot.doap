         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:gnome="http://api.gnome.org/doap-extensions#"
         xmlns="http://usefulinc.com/ns/doap#">

  <name>phosh-first-boot</name>
  <shortname>PhoshFirstBoot</shortname>
  <shortdesc>Small first-boot app for Phosh</shortdesc>
  <description>An app to run at first boot to create the initial user</description>
  <homepage rdf:resource="https://gitlab.gnome.org/World/Phosh/phosh-first-boot/" />
  <license rdf:resource="http://usefulinc.com/doap/licenses/gpl" />

  <programming-language>Rust</programming-language>

  <maintainer>
    <foaf:Person>
      <foaf:name>Guido Günther</foaf:name>
      <foaf:mbox rdf:resource="mailto:agx@sigxcpu.org" />
      <gnome:userid>guidog</gnome:userid>
    </foaf:Person>
  </maintainer>
</Project>
