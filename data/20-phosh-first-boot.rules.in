// -*- mode: js; js-indent-level: 4; indent-tabs-mode: nil -*-
//
// DO NOT EDIT THIS FILE, it will be overwritten on update.
//
// Allow the _greetd user to do certain actions without
// being interrupted by password dialogs

polkit.addRule(function(action, subject) {
    if (subject.user !== '@setup_user@')
        return undefined;

    var actionMatches = (
        action.id.indexOf('org.freedesktop.NetworkManager.') === 0 ||
        action.id.indexOf('org.freedesktop.accounts.') === 0 ||
        action.id.indexOf('org.freedesktop.home1.') === 0 ||
        action.id.indexOf('org.freedesktop.locale1.') === 0 ||
        action.id.indexOf('org.freedesktop.timedate1.') === 0 ||
        action.id.indexOf('org.freedesktop.hostname1.') === 0 ||
        false // sentinel to ease sorting
    );

    if (actionMatches) {
        if (subject.local)
            return 'yes';
        else
            return 'auth_admin';
    }

    return undefined;
});
